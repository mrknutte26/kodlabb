{
  "name": "code-learn-app",
  "version": "1.0.0",
  "description": "Interaktiv app för att lära sig koda – stödjer JavaScript, Python och HTML/CSS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --linux"
  },
  "author": "CodeLearner",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "monaco-editor": "^0.44.0"
  },
  "build": {
    "appId": "com.codelearn.app",
    "productName": "CodeLearner",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "linux": {
      "target": "AppImage",
      "icon": null
    }
  }
}
